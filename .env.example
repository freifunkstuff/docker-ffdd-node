# Beispielwerte fuer lokales Testen mit docker compose.
#
# Nutzung:
#   cp .env.example .env
#   docker compose up --build

# User-Inputs kommen per Env.
# Persistente Laufzeitdaten wie node_id, register_key sowie fastd- und wireguard-secret landen in /data/node.yaml.

# Pflicht: Kontakt fuer den Knoten.
NODE_CONTACT_EMAIL=admin@example.org

# Pflichtfach mit eingeschraenkter Wertemenge.
# Erlaubt: Dresden, Leipzig
NODE_COMMUNITY=Dresden

# Optional: Knotenname fuer Karte/Sysinfo, nicht der Name des Eigentuemers.
NODE_NAME=
NODE_CONTACT_LOCATION=
NODE_CONTACT_NOTE=

# Optional: GPS ist laut Wiki eigentlich Pflicht.
# Im ersten Schritt erzeugt ein fehlender Wert nur eine Warnung und keinen Startabbruch.
NODE_GPS_LATITUDE=
NODE_GPS_LONGITUDE=
NODE_GPS_ALTITUDE=0

FASTD_PORT=5002
WIREGUARD_PORT=51820

# Leer lassen, um die Defaults aus config/defaults.yaml zu verwenden.
BACKBONE_PEERS=
# 0 disables ALL backbone connections (local mesh-interface-only operation).
BACKBONE_ENABLED=1

# registered (default) or temporary (persistent adapted FFDD ID 900..999, no Registry requests).
NODE_REGISTRATION_MODE=registered
# Reporting role: node for routers/offloaders; server for gateway/server reporting.
# Does not enable an Internet exit. server remains default for compatibility.
NODE_TYPE=server
# Optional migration safety pin: reject persisted/registry IDs other than this ID.
# 0 (default) keeps automatic assignment; not compatible with temporary mode.
NODE_EXPECTED_ID=0
# Optional device description; Collector prefers nonempty MODEL2.
SYSINFO_BOARD=docker
SYSINFO_MODEL=docker-alpine
SYSINFO_MODEL2=
# Container image defaults to container; native Python may use auto or host.
SYSINFO_RESOURCE_SCOPE=container

# Optional image-owned default-route handoff; all blank keeps existing routing.
# Preserve management destinations via its original gateway before moving default.
NODE_UPLINK_INTERFACE=
NODE_UPLINK_GATEWAY=
NODE_MANAGEMENT_INTERFACE=
NODE_MANAGEMENT_GATEWAY=
NODE_MANAGEMENT_ROUTES=

# Leer lassen, um die Defaults aus config/defaults.yaml zu verwenden.
NODE_REGISTRATION_URL=

# TLS bleibt immer verifiziert (HTTPS erforderlich).
# Leer: System-CAs; nur fuer den Default-Host die mitgelieferte FFDD-CA.
# Optional: PEM-CA-Bundle im Container, z.B. /data/registration-ca.pem.
# Datei aus vertrauenswuerdiger Quelle beziehen und read-only mounten.
NODE_REGISTRATION_CA_FILE=

# 1 bis 6 Stunden
REGISTRAR_INTERVAL=3600
BMXD_PREFERRED_GATEWAY=
# true (default): select only gateways advertising COMMUNITY_GATEWAY, not a region filter.
# false: also consider ordinary non-community exits. Also accepts 1/0.
BMXD_ONLY_COMMUNITY_GATEWAYS=true

# Optional: existing interfaces inside the container, separated by whitespace.
# Node configures FFDD mesh L3/bmxd only, not VLANs or external bridges.
MESH_INTERFACES=

# Optional LAN/uplink -> FFDD access; disabled by default. No Internet exit.
# Trust only explicit source CIDRs actually visible at the container uplink.
# When enabled, SOURCES is mandatory (whitespace-separated canonical IPv4 CIDRs).
# Example: LAN_MESH_ACCESS_SOURCES=192.168.10.0/24 192.168.20.5/32
# Target is fixed to 10.200.0.0/16; ingress follows the MAIN IPv4 default route.
LAN_MESH_ACCESS_ENABLED=false
LAN_MESH_ACCESS_SOURCES=

# Optional local macvlan example: docker compose -f docker-compose.yaml -f docker-compose.mesh.yaml up -d --build
# The override supplies mesh0; runtime parent can be a VLAN trunk subinterface.
# MESH_PARENT_INTERFACE=enp6s0.1062

# Optional HTTP bind address and port (default: all interfaces, port 80).
# HTTP_BIND_ADDRESS=127.0.0.1
# HTTP_PORT=8080